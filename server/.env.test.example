# Copy to `.env.test`. The database name MUST end in `_test` — tests/helpers/env.js
# refuses to run otherwise, so a stray config can never truncate the dev database.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/roadmate_test"
JWT_SECRET="roadmate_test_secret"

# Phase 1.8. RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET are deliberately absent in
# tests: without them `src/lib/razorpay.js` takes its stub path and no test
# makes a network call. The webhook secret is still needed, because signature
# verification is real whether or not live credentials exist.
# tests/helpers/env.js sets this default, so it is optional here.
RAZORPAY_WEBHOOK_SECRET="roadmate_test_webhook_secret"

# Cloudinary is deliberately absent here, and this one matters more than the
# others: with credentials present the suite would upload to — and prune from —
# the client's live account. Without them `src/lib/cloudinary.js` stubs out,
# `signUpload` returns `live: false`, and `isOurAsset` accepts any http(s) URL,
# which is what lets the existing prescription and proof-of-delivery tests keep
# posting `https://example.com/...`.
#   CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET — .env only.
#
# MSG91 (OTP SMS) is deliberately absent here too — `src/lib/sms.js` short-
# circuits under NODE_ENV=test regardless, so no test makes a network call even
# if these leak into the environment. In production set:
#   MSG91_AUTH_KEY, MSG91_TEMPLATE_ID, and optionally MSG91_SENDER_ID.
# Nothing else changes: no caller, no route, no schema.
