# Copy to `.env`. Every value here is a real credential in production — `.env` is
# gitignored and must stay that way.
#
# ⚠️ Do NOT put third-party credentials in `.env.test`. Several libraries
# (`razorpay.js`, `sms.js`, `cloudinary.js`) deliberately take a stub path when
# their credentials are ABSENT, which is what guarantees no test ever makes a
# network call or touches the client's live account. See `.env.test.example`.

# --- Core -------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/roadmate"
JWT_SECRET="change_me"
PORT=5000

# Comma-separated. The 7 web dashboards' origin(s).
CORS_ORIGIN="http://localhost:5173"
# Where a CUSTOMER'S BROWSER can reach this server. Used to build the payment
# link the Customer app opens (`GET /pay/:orderId`), and nothing else.
#
# Leave it empty in development: the URL is then derived from the request, which
# is already an address the phone could reach, since the phone is what asked.
# Set it to an **https** origin anywhere real — Razorpay's checkout script is
# served over https and browsers refuse to run it inside a plain-http page.
# Behind a tunnel (`cloudflared tunnel --url http://localhost:5000`), this is the
# tunnel's URL, and it changes every time the tunnel restarts.
PUBLIC_BASE_URL=""
# The Customer app's deep-link scheme (`apps/consumer/app.json`). The payment
# page sends the customer back to their order with it once Razorpay is done.
APP_SCHEME="roadmate"

# --- Running on a host that gives you ONE process -----------------------------
# Both default to OFF, and both should stay off wherever a second process and a
# real cron exist. `npm run sweeper` as its own worker and cron pointed at the
# three one-shots is still the right topology: anything living inside the web
# service stops when the web service does.
#
# They exist because a free tier gives you neither, and the alternative is not
# "slightly degraded" — it is an accept window that never expires, and a
# platform where nobody is ever invoiced.
#
# ⚠️ Turning either on alongside the real thing is SAFE, not double work in the
# damaging sense: every job here is claimed per row or bounded by a unique
# constraint, so a second runner duplicates effort and never double-pays.

# The 60-second accept window, enforced from inside the API. Without some
# sweeper no offer ever times out and no order ever reroutes.
RUN_SWEEPER_IN_PROCESS="false"

# Billing, settlement and upload pruning, on a daily timer inside the API.
# ⚠️ Without billing NOBODY IS EVER INVOICED, and partner subscriptions are the
# platform's entire income since commission_percent went to 0.
RUN_JOBS_IN_PROCESS="false"

# Both optional, and only worth setting to watch the scheduler work — the
# defaults (a 24h interval, a 60s delay before the first run) are what you want
# in production. The delay keeps three maintenance jobs off the CPU during a
# cold start, which on a free tier is somebody's first page load.
# JOBS_INTERVAL_MS="86400000"
# JOBS_FIRST_RUN_DELAY_MS="60000"

# --- Razorpay (Phase 1.8) ---------------------------------------------------
# Without KEY_ID / KEY_SECRET, `src/lib/razorpay.js` stubs out: order creation
# and refunds become no-ops and the pipeline still runs end to end on COD.
# The WEBHOOK_SECRET is different — signature verification is real whether or
# not live credentials exist, and it fails CLOSED without a secret, so a missing
# value means every webhook is rejected rather than trusted.
# Point the Razorpay dashboard at POST /api/payments/razorpay/webhook.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# --- MSG91 (OTP SMS) --------------------------------------------------------
# Without these, `src/lib/sms.js` logs instead of sending and the OTP comes back
# in the response body when NODE_ENV !== 'production'. In production a send
# failure answers 502 SMS_DELIVERY_FAILED rather than claiming "OTP sent" for a
# code nobody will receive.
# Needs one approved DLT template with a SINGLE variable (the OTP).
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
MSG91_SENDER_ID=""

# PAUSED until launch (2026-08-11): the client's DLT portal subscription lapsed,
# so MSG91 cannot deliver and they will renew it at launch. Leave the three keys
# above empty and set this to keep sign-in usable on a NODE_ENV=production host —
# the OTP comes back in the /otp/request response instead of by SMS.
#
# AT LAUNCH, in this order:
#   1. client renews DLT + approves the OTP template
#   2. fill MSG91_AUTH_KEY / MSG91_TEMPLATE_ID (/ MSG91_SENDER_ID)
#   3. delete this flag  ← without step 3 the code still leaks in the response
OTP_ECHO_CODE="true"

# --- Cloudinary (file storage) ----------------------------------------------
# Proof-of-delivery photos and signatures, prescription uploads, product images.
# Chosen over S3 on 2026-08-07: free at launch volume, and it resizes in the URL
# so nothing has to build thumbnail generation.
#
# ⚠️ CLOUDINARY_API_SECRET IS SERVER-ONLY. It must never become an
# EXPO_PUBLIC_* variable — those are compiled into the app bundle and readable
# from the APK. Mobile uploads are authorised by a short-lived signature the
# server generates; the app never holds the secret. Same rule as the Razorpay
# key secret.
#
# ⚠️ Prescriptions are medical records, not product photos. They must be stored
# as private/authenticated assets so a URL cannot be guessed or forwarded.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
