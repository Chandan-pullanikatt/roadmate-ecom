# The admin portal's API origin. Copy to `.env` for local work, and set the
# same key in the Vercel project settings for every deployed build.
#
# ⚠️ This is a Vite variable, so it is baked into the bundle at BUILD time, not
# read at runtime. Changing it in Vercel does nothing until you redeploy.
#
# ⚠️ If it is unset, `client/src/utils/api.js` falls back to
# `http://localhost:5000/api` — which on a deployed site means the *visitor's*
# own machine. Every request then fails, and because each dashboard initialises
# its numbers to 0, the portal renders a complete screen of zeros instead of an
# error. That is what happened to the Vercel build; the ErrorBanner now says so
# out loud, but the fix is still to set this.
#
# Note the `/api` suffix — the base URL includes it, and the endpoints in
# `api.js` are written relative to it (`/auth/login`, not `/api/auth/login`).
VITE_API_URL=http://localhost:5000/api

# For the deployed portal, this is your API service origin, e.g.
# VITE_API_URL=https://roadmate-api.onrender.com/api
#
# Whatever you set here, the server's CORS_ORIGIN must include the site that
# calls it, or the browser blocks the response and you are back to zeros.
