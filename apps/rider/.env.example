# Copy to `.env` in this directory. `EXPO_PUBLIC_*` vars are inlined into the
# bundle by Expo — never put a secret here; this file is for addresses only.

# Where the API is. `localhost` is always wrong on a physical device: the phone
# resolves it to itself. Use the dev machine's LAN address, the one `expo start`
# prints in the QR URL.
EXPO_PUBLIC_API_URL=http://192.168.1.5:5000

# Reminders, not settings — both are separate processes and this app is useless
# without them running against the same API:
#
#   npm run sweeper     enforces the 60-second accept window. Without it no offer
#                       ever expires, no order ever reaches a shop that accepts,
#                       and no delivery job is ever created for a rider to take.
#   npm run server      the API itself.
#
# A rider is never given work by polling: assignment happens when the shop marks
# the order READY. If the job list stays empty, the shop half of the pipeline is
# where to look first.
