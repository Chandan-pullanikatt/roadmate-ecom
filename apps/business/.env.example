# Copy to `.env` in this directory. `EXPO_PUBLIC_*` vars are inlined into the
# bundle by Expo — never put a secret here; this file is for addresses only.

# Where the API is. `localhost` is always wrong on a physical device: the phone
# resolves it to itself. Use the dev machine's LAN address, the one `expo start`
# prints in the QR URL.
EXPO_PUBLIC_API_URL=http://192.168.1.5:5000

# Reminder, not a setting: the 60-second accept window is enforced by the
# sweeper, a second process. Run `npm run sweeper` from the repo root alongside
# the API in any environment you demo against, or no offer ever expires and the
# countdown on screen is decoration.
